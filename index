    async function initFirebase() {
      const cfg = getFirebaseConfig();
      if (!cfg || !cfg.apiKey) {
        setSyncBadge('local', 'Ready (Local Mode)');
        document.getElementById('modalSyncEngineStatus').textContent = 'Local Mode (Add Firebase Config for Multi-Device)';
        document.getElementById('modalSyncEngineStatus').className = 'font-semibold text-amber-400';
        return;
      }

      try {
        fbApp = initializeApp(cfg);
        fbAuth = getAuth(fbApp);
        fbDb = getFirestore(fbApp);

        // Enable IndexedDB offline persistence for seamless mobile/desktop offline resilience
        try {
          await enableIndexedDbPersistence(fbDb);
        } catch (persistenceErr) {
          console.warn("IndexedDB persistence note:", persistenceErr.code);
        }

        // Authenticate first per strict auth-before-query pattern
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(fbAuth, __initial_auth_token);
        } else if (!fbAuth.currentUser) {
          await signInAnonymously(fbAuth);
        }

        onAuthStateChanged(fbAuth, (user) => {
          fbUser = user;
          updateAuthUI(user);
          if (user) {
            attachFirestoreRealtimeSync(user.uid);
          }
        });
      } catch (err) {
        console.error("Firebase init failed:", err);
        setSyncBadge('local', 'Offline Local Mode');
      }
    }

    function attachFirestoreRealtimeSync(uid) {
      if (fbUnsubscribe) fbUnsubscribe();
      const docRef = doc(fbDb, 'artifacts', runtimeAppId, 'users', uid, 'challengeData', 'main');

      fbUnsubscribe = onSnapshot(
        docRef,
        (snap) => {
          if (snap.exists()) {
            const remote = snap.data();
            if (!remote.updatedAt || remote.updatedAt >= appState.updatedAt) {
              isRemoteUpdate = true;
              appState.startingCapital = Number(remote.startingCapital) || 10000;
              appState.dailyRate = Number(remote.dailyRate) || 6.0;
              appState.days = remote.days || {};
              appState.celebratedMilestones = Array.isArray(remote.celebratedMilestones) ? remote.celebratedMilestones : [];
              appState.updatedAt = remote.updatedAt || Date.now();
              persistSessionMirror();
              renderAll();
              isRemoteUpdate = false;
            }
          } else {
            // Seed initial cloud doc
            triggerAutoSave();
          }
          setSyncBadge('cloud', 'Saved to Cloud ✓');
        },
        (error) => {
          console.error("Firestore snapshot error:", error);
          setSyncBadge('local', 'Offline Sync Queued');
        }
      );
    }

