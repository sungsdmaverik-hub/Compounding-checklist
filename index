    // =========================================================================
    // 6. CORE CALCULATIONS (KPIs, COMPOUNDING SCHEDULE, ANALYTICS)
    // =========================================================================
    function computeMetrics() {
      const startCap = appState.startingCapital;
      let totalPnl = 0;
      let completedCount = 0;
      let bestDay = null;  // { day, pnl }
      let worstDay = null; // { day, pnl }
      let winDays = 0;
      let lossDays = 0;

      for (let d = 1; d <= TOTAL_DAYS; d++) {
        const entry = appState.days[String(d)];
        if (!entry) continue;
        if (entry.status === 'completed') completedCount++;

        if (entry.pnl !== null && entry.pnl !== undefined && entry.pnl !== '' && !isNaN(Number(entry.pnl))) {
          const pnlVal = Number(entry.pnl);
          totalPnl += pnlVal;
          if (pnlVal > 0) winDays++;
          if (pnlVal < 0) lossDays++;

          if (!bestDay || pnlVal > bestDay.pnl) {
            bestDay = { day: d, pnl: pnlVal };
          }
          if (!worstDay || pnlVal < worstDay.pnl) {
            worstDay = { day: d, pnl: pnlVal };
          }
        }
      }

      const currentCapital = startCap + totalPnl;
      const roiPct = startCap > 0 ? (totalPnl / startCap) * 100 : 0;
      const remainingDays = TOTAL_DAYS - completedCount;
      const completionPct = (completedCount / TOTAL_DAYS) * 100;
      const tradedCount = winDays + lossDays;
      const winRate = tradedCount > 0 ? (winDays / tradedCount) * 100 : 0;

      return {
        startCap,
        currentCapital,
        totalPnl,
        roiPct,
        completedCount,
        remainingDays,
        completionPct,
        bestDay,
        worstDay,
        winDays,
        lossDays,
        winRate
      };
    }

    function generateCompoundingSchedule(startCap, ratePct) {
      const rate = ratePct / 100;
      const rows = [];
      let opening = startCap;

      for (let day = 1; day <= TOTAL_DAYS; day++) {
        const targetProfit = opening * rate;
        const closing = opening + targetProfit;
        rows.push({
          day,
          opening,
          targetProfit,
          closing
        });
        opening = closing;
      }
      return rows;
    }

