      try {
        const parsed = JSON.parse(raw);
        if (!parsed.apiKey || !parsed.projectId) throw new Error("Missing apiKey or projectId");
        sessionStorage.setItem(FIREBASE_CFG_KEY, JSON.stringify(parsed));
        showToast('Firebase config saved! Connecting...');
        initFirebase();
      } catch (err) {
        showToast('Invalid JSON config. Check formatting.');
      }
    };

    window.clearCustomFirebaseConfig = function() {
      sessionStorage.removeItem(FIREBASE_CFG_KEY);
      document.getElementById('firebaseConfigTextarea').value = '';
      showToast('Custom Firebase config cleared');
    };

    // =========================================================================
    // 12. PWA MANIFEST, SERVICE WORKER & INSTALL PROMPT
    // =========================================================================
    let deferredInstallPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredInstallPrompt = e;
    });

    window.handleInstallClick = async function() {
      if (deferredInstallPrompt) {
        deferredInstallPrompt.prompt();
        const { outcome } = await deferredInstallPrompt.userChoice;
        if (outcome === 'accepted') {
          showToast('App installed! Check your Home Screen / Desktop.');
        }
        deferredInstallPrompt = null;
      } else {
        const modal = document.getElementById('installGuideModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    };

    function setupPWAManifestAndSW() {
      // Dynamic SVG Icon
      const iconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" rx="112" fill="#090d16"/><rect x="24" y="24" width="464" height="464" rx="96" fill="#111827" stroke="#10b981" stroke-width="16"/><path d="M128 340 L216 252 L276 312 L384 176" fill="none" stroke="#10b981" stroke-width="32" stroke-linecap="round" stroke-linejoin="round"/><path d="M316 176 H384 V244" fill="none" stroke="#f59e0b" stroke-width="32" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      const iconUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(iconSvg);

      const manifest = {
        name: "365-Day Trading & Compounding Challenge",
        short_name: "365 Trade",
        description: "365-Day Trading Journal & Daily Compounding Calculator",
        start_url: "./",
        display: "standalone",
        background_color: "#090d16",
        theme_color: "#090d16",
        orientation: "any",
        icons: [
          { src: iconUrl, sizes: "192x192", type: "image/svg+xml", purpose: "any maskable" },
          { src: iconUrl, sizes: "512x512", type: "image/svg+xml", purpose: "any maskable" }
        ]
      };

      try {
        const manifestBlob = new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' });
        const manifestURL = URL.createObjectURL(manifestBlob);
        const link = document.createElement('link');
        link.rel = 'manifest';
        link.href = manifestURL;
        document.head.appendChild(link);
      } catch (e) {}

      // Register Service Worker for offline shell caching
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        const swCode = `
          const CACHE_NAME = 'tc365-shell-v1';
          self.addEventListener('install', (e) => {
            self.skipWaiting();
          });
          self.addEventListener('activate', (e) => {
            e.waitUntil(clients.claim());
          });
          self.addEventListener('fetch', (e) => {
            if (e.request.method !== 'GET') return;
            e.respondWith(
              fetch(e.request).catch(() => caches.match(e.request))
            );
          });
        `;
        try {
          const swBlob = new Blob([swCode], { type: 'application/javascript' });
          const swUrl = URL.createObjectURL(swBlob);
          navigator.serviceWorker.register(swUrl).catch(() => {});
        } catch (e) {}
      }
    }

    // =========================================================================
    // 13. HELPERS & BOOTSTRAP
    // =========================================================================
    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showToast(message) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'bg-slate-900/95 border border-slate-700 text-slate-100 text-xs font-medium px-3.5 py-2.5 rounded-xl shadow-xl backdrop-blur-md transition-all transform translate-y-0 opacity-100';
      toast.textContent = message;
      container.appendChild(toast);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 2800);
    }

    window.addEventListener('resize', () => {
      if (uiState.activeTab === 'analytics') {
        drawEquityCurveCanvas();
      }
    });

    // Initialize Application
    window.addEventListener('DOMContentLoaded', () => {
      loadInitialLocalState();
      setupPWAManifestAndSW();
      renderAll();
      initFirebase();
    });
  </script>
</body>
</html>
