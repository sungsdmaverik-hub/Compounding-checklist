              dailyRate: Number(parsed.dailyRate) || 6.0,
              days: parsed.days || {},
              celebratedMilestones: Array.isArray(parsed.celebratedMilestones) ? parsed.celebratedMilestones : [],
              updatedAt: parsed.updatedAt || Date.now()
            };
          }
        }
      } catch (e) {
        console.warn("Session cache restore skipped:", e);
      }
    }

