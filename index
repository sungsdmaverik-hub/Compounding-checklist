    window.exportToCSV = function() {
      const schedule = generateCompoundingSchedule(appState.startingCapital, appState.dailyRate);
      const headers = ['Day', 'Status', 'Target Margin (INR)', 'Target Profit (INR)', 'Actual P&L (INR)', 'Cumulative Capital (INR)', 'Trade Notes'];
      const lines = [headers.join(',')];

      let cumulative = appState.startingCapital;
      for (let d = 1; d <= TOTAL_DAYS; d++) {
        const entry = appState.days[String(d)] || { status: '', pnl: '', notes: '' };
        const plan = schedule[d - 1];
        const pnlVal = (entry.pnl !== '' && entry.pnl !== null && !isNaN(Number(entry.pnl))) ? Number(entry.pnl) : 0;
        cumulative += pnlVal;

        const cleanNotes = `"${String(entry.notes || '').replace(/"/g, '""')}"`;
        lines.push([
          d,
          entry.status || 'pending',
          plan.opening.toFixed(2),
          plan.targetProfit.toFixed(2),
          entry.pnl !== '' && entry.pnl !== null ? Number(entry.pnl).toFixed(2) : '',
          cumulative.toFixed(2),
          cleanNotes
        ].join(','));
      }

      // UTF-8 BOM ensures Excel opens INR symbols cleanly
      const blob = new Blob(["\uFEFF" + lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      downloadBlob(blob, `365-Day-Trading-Challenge-${new Date().toISOString().slice(0, 10)}.csv`);
      showToast('CSV exported for Excel ✓');
    };

    window.exportToJSON = function() {
      const blob = new Blob([JSON.stringify(appState, null, 2)], { type: 'application/json' });
