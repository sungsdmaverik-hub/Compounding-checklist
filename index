    function renderAnalytics() {
      const tbody = document.getElementById('monthlySummaryBody');
      const m = computeMetrics();
      document.getElementById('overallStatsPill').textContent = `Win Rate: ${m.winRate.toFixed(1)}% • ${m.winDays}W / ${m.lossDays}L`;

      const rows = [];
      for (let month = 1; month <= 12; month++) {
        const startDay = (month - 1) * 30 + 1;
        const endDay = month === 12 ? 365 : month * 30;

        let profit = 0;
        let loss = 0;
        let completed = 0;
        let wins = 0;
        let losses = 0;

        for (let d = startDay; d <= endDay; d++) {
          const entry = appState.days[String(d)];
          if (!entry) continue;
          if (entry.status === 'completed') completed++;
          if (entry.pnl !== '' && entry.pnl !== null && !isNaN(Number(entry.pnl))) {
            const val = Number(entry.pnl);
            if (val > 0) {
              profit += val;
              wins++;
            } else if (val < 0) {
              loss += Math.abs(val);
              losses++;
            }
          }
        }

        const net = profit - loss;
        const totalTraded = wins + losses;
        const winRate = totalTraded > 0 ? (wins / totalTraded) * 100 : 0;

        rows.push(`
          <tr class="hover:bg-slate-800/40">
            <td class="py-3 px-4">
              <div class="font-bold text-white">Month ${month}</div>
              <div class="text-[11px] text-slate-500">Days ${startDay}–${endDay}</div>
            </td>
            <td class="py-3 px-4 text-right text-emerald-400">+${formatINR(profit)}</td>
            <td class="py-3 px-4 text-right text-red-400">-${formatINR(loss)}</td>
            <td class="py-3 px-4 text-right font-bold ${net >= 0 ? 'text-emerald-400' : 'text-red-400'}">${formatSignedINR(net)}</td>
            <td class="py-3 px-4 text-center text-slate-300">${winRate.toFixed(0)}%</td>
            <td class="py-3 px-4 text-right text-slate-300">${completed} / ${endDay - startDay + 1}</td>
          </tr>
        `);
      }

      tbody.innerHTML = rows.join('');
      drawEquityCurveCanvas();
    }

    function drawEquityCurveCanvas() {
      const canvas = document.getElementById('equityChartCanvas');
      if (!canvas) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;

      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const width = rect.width;
      const height = rect.height;
      ctx.clearRect(0, 0, width, height);

      // Build equity points up to highest logged day (or Day 30 minimum)
      let running = appState.startingCapital;
      const points = [{ day: 0, val: running }];
      let lastLoggedDay = 0;

      for (let d = 1; d <= TOTAL_DAYS; d++) {
        const entry = appState.days[String(d)];
        if (entry && entry.pnl !== '' && entry.pnl !== null && !isNaN(Number(entry.pnl))) {
          running += Number(entry.pnl);
          lastLoggedDay = d;
        }
        points.push({ day: d, val: running });
      }

      const displayLimit = Math.max(30, lastLoggedDay + 5);
      const visiblePoints = points.slice(0, Math.min(TOTAL_DAYS + 1, displayLimit + 1));

      const vals = visiblePoints.map(p => p.val);
      const minVal = Math.min(...vals, appState.startingCapital * 0.95);
      const maxVal = Math.max(...vals, appState.startingCapital * 1.05);
      const range = maxVal - minVal || 1;

      const padLeft = 14;
      const padRight = 14;
      const padTop = 16;
      const padBottom = 22;
      const plotW = width - padLeft - padRight;
      const plotH = height - padTop - padBottom;

      const getX = (idx) => padLeft + (idx / (visiblePoints.length - 1)) * plotW;
      const getY = (val) => padTop + plotH - ((val - minVal) / range) * plotH;

      // Baseline (Starting Capital)
      const baseY = getY(appState.startingCapital);
      ctx.save();
      ctx.strokeStyle = '#334155';
      ctx.setLineDash([4, 4]);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padLeft, baseY);
      ctx.lineTo(width - padRight, baseY);
      ctx.stroke();
      ctx.restore();

      // Equity Gradient Fill
      const grad = ctx.createLinearGradient(0, padTop, 0, height - padBottom);
      grad.addColorStop(0, 'rgba(16, 185, 129, 0.30)');
      grad.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

      ctx.beginPath();
      ctx.moveTo(getX(0), height - padBottom);
      visiblePoints.forEach((pt, idx) => {
        ctx.lineTo(getX(idx), getY(pt.val));
      });
      ctx.lineTo(getX(visiblePoints.length - 1), height - padBottom);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      // Equity Line
      ctx.beginPath();
      visiblePoints.forEach((pt, idx) => {
        const x = getX(idx);
        const y = getY(pt.val);
        if (idx === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Axis labels
      ctx.fillStyle = '#64748b';
      ctx.font = '10px JetBrains Mono, monospace';
      ctx.fillText(`Day 0 (${formatCompactIndian(appState.startingCapital)})`, padLeft, height - 6);
      const lastPt = visiblePoints[visiblePoints.length - 1];
      const endLabel = `Day ${lastPt.day} (${formatCompactIndian(lastPt.val)})`;
      ctx.fillText(endLabel, width - padRight - ctx.measureText(endLabel).width, height - 6);
    }

