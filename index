<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#090d16" />
  <meta name="description" content="365-Day Trading & Compounding Challenge - Real-time cross-device trading journal, 5%-7% daily compounding calculator, and milestone tracker." />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="365 Trade" />
  <title>365-Day Trading & Compounding Challenge</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['JetBrains Mono', 'Fira Code', 'monospace']
          },
          colors: {
            terminal: {
              bg: '#090d16',
              card: '#111827',
              elevated: '#161f32',
              border: '#1e293b'
            }
          }
        }
      }
    };
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    body {
      background-color: #090d16;
      color: #f1f5f9;
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #090d16;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }

    /* Custom Range Slider */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 8px;
      border-radius: 999px;
      background: linear-gradient(90deg, #10b981 0%, #f59e0b 100%);
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      margin-top: -6px;
      background-color: #f8fafc;
      border: 3px solid #10b981;
      height: 20px;
      width: 20px;
      border-radius: 50%;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.6);
      transition: transform 0.15s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }

    /* Hide number spinners */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type="number"] {
      -moz-appearance: textfield;
    }

    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.35); }
      50% { box-shadow: 0 0 18px 2px rgba(245, 158, 11, 0.55); }
    }
    .milestone-unlocked-glow {
      animation: pulseGlow 2.8s infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-emerald-500/30 selection:text-emerald-200">

  <!-- Confetti Canvas Overlay -->
  <canvas id="confettiCanvas" class="fixed inset-0 pointer-events-none z-50 hidden"></canvas>

  <!-- Toast Notification Banner -->
  <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-[calc(100%-2rem)] sm:w-auto pointer-events-none"></div>

  <!-- Sticky Top App Header -->
  <header class="sticky top-0 z-30 bg-[#090d16]/90 backdrop-blur-md border-b border-slate-800/90">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-2">
      <!-- Brand Logo & Title -->
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center shadow-lg shadow-emerald-950/60 border border-emerald-400/30 shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-sm sm:text-base font-bold tracking-tight text-white leading-tight">365-Day Trading Challenge</h1>
            <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/15 text-amber-400 border border-amber-500/30">
              INR COMPOUNDING
            </span>
          </div>
          <p class="text-[11px] text-slate-400 hidden sm:block">Discipline • Risk Management • Daily Compounding Terminal</p>
        </div>
      </div>

      <!-- Right Controls: Sync Badge, Install PWA, Cloud Auth -->
      <div class="flex items-center gap-2">
        <!-- Cloud Sync Status Pill -->
        <div id="syncStatusBadge" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-medium text-emerald-400 transition-all">
          <span id="syncDot" class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span id="syncText">Saved to Cloud ✓</span>
        </div>

        <!-- Install PWA Button -->
        <button id="installPwaBtn" onclick="handleInstallClick()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold transition active:scale-95" title="Install App on Android or Windows">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="hidden sm:inline">Install App</span>
        </button>

        <!-- Account / Firebase Setup Button -->
        <button id="authModalBtn" onclick="openAuthModal()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/40 text-xs font-semibold transition active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
          </svg>
          <span id="authBtnLabel">Cloud Sync</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content Wrapper -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6 space-y-5">

    <!-- 2. AUTOMATIC TOP DASHBOARD (LIVE KPIs) -->
    <section aria-label="Live Trading Performance Dashboard" class="space-y-3">
      <!-- Top Row: 4 Primary Financial KPIs -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Starting Capital -->
        <div class="bg-[#111827] border border-slate-800/90 rounded-2xl p-3.5 sm:p-4 relative group">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-slate-400">Starting Capital</span>
            <button onclick="openCapitalModal()" class="text-[11px] text-slate-400 hover:text-emerald-400 px-1.5 py-0.5 rounded bg-slate-800/70 transition" title="Edit Starting Capital">
              Edit
            </button>
          </div>
          <div id="kpiStartingCapital" class="text-lg sm:text-2xl font-bold font-mono text-white tabular-nums">₹10,000.00</div>
          <div id="kpiTargetRateLabel" class="text-[11px] text-slate-400 mt-1">Daily Target: <span class="text-amber-400 font-semibold">6.0%</span></div>
        </div>

        <!-- Current Capital -->
        <div class="bg-[#111827] border border-slate-800/90 rounded-2xl p-3.5 sm:p-4">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-slate-400">Current Capital</span>
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          </div>
          <div id="kpiCurrentCapital" class="text-lg sm:text-2xl font-bold font-mono text-white tabular-nums">₹10,000.00</div>
          <div id="kpiCompactCapital" class="text-[11px] text-slate-400 mt-1">Base + Realized P&L</div>
        </div>

        <!-- Total Profit/Loss -->
        <div class="bg-[#111827] border border-slate-800/90 rounded-2xl p-3.5 sm:p-4">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-slate-400">Total Profit / Loss</span>
            <span id="kpiRoiBadge" class="px-2 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-emerald-500/15 text-emerald-400">+0.00%</span>
          </div>
          <div id="kpiTotalPnl" class="text-lg sm:text-2xl font-bold font-mono text-emerald-400 tabular-nums">₹0.00</div>
          <div id="kpiWinRateMini" class="text-[11px] text-slate-400 mt-1">Overall ROI & Net Return</div>
        </div>

        <!-- Completed & Remaining Days -->
        <div class="bg-[#111827] border border-slate-800/90 rounded-2xl p-3.5 sm:p-4">
          <div class="flex items-center justify-between mb-1">
            <span class="text-[11px] sm:text-xs font-medium uppercase tracking-wider text-slate-400">Completed Days</span>
            <span id="kpiRemainingBadge" class="text-[11px] font-medium text-slate-400">365 left</span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span id="kpiCompletedDays" class="text-lg sm:text-2xl font-bold font-mono text-white tabular-nums">0</span>
            <span class="text-xs sm:text-sm font-mono text-slate-400">/ 365</span>
          </div>
          <div class="w-full bg-slate-800 h-2 rounded-full mt-2 overflow-hidden">
            <div id="kpiProgressBar" class="bg-gradient-to-r from-emerald-500 to-amber-400 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <!-- Second Row: Remaining Days, Best Day, Worst Day -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Remaining Days Card -->
        <div class="bg-[#111827]/90 border border-slate-800/80 rounded-xl px-4 py-2.5 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-amber-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] text-slate-400 uppercase tracking-wider">Remaining Days</div>
              <div id="kpiRemainingDays" class="text-sm sm:text-base font-bold font-mono text-slate-100 tabular-nums">365 Days</div>
            </div>
          </div>
          <span id="kpiCompletionPct" class="text-xs font-mono text-slate-400">0.0% Done</span>
        </div>

        <!-- Best Day Card -->
        <div class="bg-[#111827]/90 border border-slate-800/80 rounded-xl px-4 py-2.5 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/15 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] text-slate-400 uppercase tracking-wider">Best Day</div>
              <div id="kpiBestDay" class="text-sm sm:text-base font-bold font-mono text-emerald-400 tabular-nums">—</div>
            </div>
          </div>
          <span id="kpiBestDayNum" class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-300 text-xs font-mono">No data</span>
        </div>

        <!-- Worst Day Card -->
        <div class="bg-[#111827]/90 border border-slate-800/80 rounded-xl px-4 py-2.5 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-red-500/15 border border-red-500/20 flex items-center justify-center text-red-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] text-slate-400 uppercase tracking-wider">Worst Day</div>
              <div id="kpiWorstDay" class="text-sm sm:text-base font-bold font-mono text-red-400 tabular-nums">—</div>
            </div>
          </div>
          <span id="kpiWorstDayNum" class="px-2 py-0.5 rounded-md bg-red-500/10 text-red-300 text-xs font-mono">No data</span>
        </div>
      </div>
    </section>

    <!-- Primary Tab Navigation -->
    <nav class="flex p-1 bg-[#111827] border border-slate-800 rounded-2xl gap-1 overflow-x-auto" role="tablist">
      <button id="tabBtnJournal" onclick="switchTab('journal')" role="tab" class="flex-1 min-w-[130px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 transition bg-emerald-600 text-white shadow-md">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
        <span>365-Day Journal</span>
      </button>
      <button id="tabBtnCalculator" onclick="switchTab('calculator')" role="tab" class="flex-1 min-w-[140px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 transition text-slate-400 hover:text-white hover:bg-slate-800/60">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
        <span>Compounding Table</span>
      </button>
      <button id="tabBtnAnalytics" onclick="switchTab('analytics')" role="tab" class="flex-1 min-w-[130px] py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 transition text-slate-400 hover:text-white hover:bg-slate-800/60">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span>Analytics & Export</span>
      </button>
    </nav>

    <!-- =================================================================== -->
    <!-- TAB 1: INTERACTIVE 365-DAY TRADING CHECKLIST & JOURNAL              -->
    <!-- =================================================================== -->
    <section id="panelJournal" class="space-y-4">
      <!-- 4. MILESTONES TROPHY BAR -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-4">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <span class="text-base">🏆</span>
            <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-amber-400">50-Day Milestones Trophy Bar</h2>
          </div>
          <span id="nextMilestoneHint" class="text-xs text-slate-400">Next milestone: <strong class="text-white">50 Completed Days</strong></span>
        </div>
        <div id="milestonesTrophyGrid" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Journal Filters, Search & Phase Selector -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-3.5 sm:p-4 space-y-3">
        <!-- Top Bar: Status Filters + Jump to Day -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
          <!-- Status Filter Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0" id="journalFilterPills">
            <button data-filter="all" onclick="setJournalFilter('all')" class="filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-600 text-white shrink-0">All (365)</button>
            <button data-filter="completed" onclick="setJournalFilter('completed')" class="filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">Completed</button>
            <button data-filter="notrade" onclick="setJournalFilter('notrade')" class="filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">No Trade</button>
            <button data-filter="missed" onclick="setJournalFilter('missed')" class="filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700 shrink-0">Missed</button>
            <button data-filter="profit" onclick="setJournalFilter('profit')" class="filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-emerald-400 hover:bg-slate-700 shrink-0">Profitable Days</button>
            <button data-filter="loss" onclick="setJournalFilter('loss')" class="filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 text-red-400 hover:bg-slate-700 shrink-0">Loss Days</button>
          </div>

          <!-- Search Notes & Jump to Day -->
          <div class="flex items-center gap-2">
            <div class="relative flex-1 sm:w-56">
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input id="journalSearchInput" type="text" oninput="handleJournalSearch(this.value)" placeholder="Search notes, setup, pair..." class="w-full pl-9 pr-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500" />
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <input id="journalJumpInput" type="number" min="1" max="365" placeholder="Day #" class="w-16 px-2.5 py-1.5 rounded-xl bg-slate-900 border border-slate-700 text-xs font-mono text-white placeholder-slate-500 focus:outline-none focus:border-amber-500" />
              <button onclick="jumpToJournalDay()" class="px-2.5 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 text-xs font-semibold transition">Go</button>
            </div>
          </div>
        </div>

        <!-- Fast Phase / Block Selector (Keeps mobile scrolling super fast) -->
        <div id="journalPhaseBar" class="flex items-center gap-1.5 overflow-x-auto pt-1 border-t border-slate-800/80">
          <span class="text-[11px] font-semibold text-slate-400 uppercase mr-1 shrink-0">Block:</span>
          <!-- Phase buttons injected via JS -->
        </div>
      </div>

      <!-- Journal Day Cards List -->
      <div id="journalCardsContainer" class="space-y-3">
        <!-- Dynamically rendered Day cards -->
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- TAB 2: CORE FINANCIAL LOGIC & COMPOUNDING CALCULATOR                -->
    <!-- =================================================================== -->
    <section id="panelCalculator" class="hidden space-y-4">
      <!-- Calculator Controls Card -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <span>Daily Compounding Roadmap (Day 1 – Day 365)</span>
              <span class="px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 text-xs font-mono" id="calcRateBadge">6.0% / day</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Adjust your daily compounding target rate between 5.0% and 7.0% or compare all three scenarios side by side.</p>
          </div>

          <!-- Comparison Toggle -->
          <label class="inline-flex items-center gap-2.5 cursor-pointer bg-slate-900 px-3.5 py-2 rounded-xl border border-slate-700/80 self-start">
            <input type="checkbox" id="compareRatesToggle" onchange="toggleRateComparison(this.checked)" class="sr-only peer" />
            <div class="w-9 h-5 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all relative peer-checked:bg-amber-500"></div>
            <span class="text-xs font-semibold text-slate-200">Compare 5% vs 6% vs 7%</span>
          </label>
        </div>

        <!-- Rate Slider & Preset Buttons -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center bg-slate-900/70 p-3.5 rounded-xl border border-slate-800">
          <div class="md:col-span-7 space-y-2">
            <div class="flex justify-between text-xs font-medium">
              <span class="text-slate-400">Daily Target Rate Slider</span>
              <span id="sliderRateValue" class="font-mono font-bold text-amber-400 text-sm">6.0%</span>
            </div>
